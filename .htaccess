DirectoryIndex index.php

ErrorDocument 404 /index

RewriteEngine On

Options -Indexes

# Make accueil.php the default index file


# Redirect URL/file.php to URL/file
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.php [NC]
RewriteRule ^([^.]+)\.php$ /$1 [R=301,L]

# Redirect URL/file to URL/file.php if the .php file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*[^/])/?$ $1.php [NC,L]

# Store images in the cache for one year
# Only images in the img folder are stored in the cache for one year
# SetEnvIf Request_URI "^/img/.*\.(jpg|png|gif)$" IS_IMAGE
# Header set Cache-Control "max-age=31536000" env=IS_IMAGE


