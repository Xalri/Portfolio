{
    "name": "xalri/portfolio",
    "description": "Samy's portfolio, served by Apache from public/",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "league/commonmark": "^2.7",
        "symfony/mailer": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Portfolio\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        }
    }
}
